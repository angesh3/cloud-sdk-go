FROM golang:1.21-alpine AS build

# Copy the entire cisco-pxgrid/cloud-sdk-go repository
WORKDIR /go/src/github.com/cisco-pxgrid
COPY ../../ ./cloud-sdk-go/

# Build the application
WORKDIR /go/src/github.com/cisco-pxgrid/cloud-sdk-go/pxgrid-cloud-demo/backend
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -o pxgrid-demo .

# Create a minimal runtime image
FROM alpine:latest

WORKDIR /app

# Copy the binary from build stage
COPY --from=build /go/src/github.com/cisco-pxgrid/cloud-sdk-go/pxgrid-cloud-demo/backend/pxgrid-demo .
COPY --from=build /go/src/github.com/cisco-pxgrid/cloud-sdk-go/pxgrid-cloud-demo/backend/frontend /app/frontend

# Make config directory
RUN mkdir -p /app/config

# Install CA certificates for TLS
RUN apk --no-cache add ca-certificates

# Set executable permissions
RUN chmod +x /app/pxgrid-demo

# Expose port for API and WebSocket
EXPOSE 8080

# Run the application
CMD ["/app/pxgrid-demo"]
